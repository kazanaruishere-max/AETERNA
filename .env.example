# ====================================================================
# AETERNA QUANT - Environment Variables Template (.env.example)
# Dilarang memasukkan kredensial riil ke file ini.
# Copy ke .env untuk konfigurasi lokal dan pastikan .env tetap git-ignored.
# ====================================================================

# Telegram Control Panel & Alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_USER_ID=123456789  # Integer ID, bukan username string

# Exness MT5 Credentials (Windows Native Execution)
EXNESS_MT5_LOGIN=12345678
EXNESS_MT5_PASSWORD="your_mt5_trading_password_here"
EXNESS_MT5_SERVER="Exness-MT5Real"
EXNESS_ACCOUNT_TYPE="Standard"

# OANDA v20 API (Market Scanning Only - No Execution)
OANDA_API_TOKEN="b02276539583a2405b92f3126c52a8c6-02a7f738f05061ccce8ac2fe31e9607a"
OANDA_ACCOUNT_ID="101-003-39760450-004"
OANDA_ENVIRONMENT="practice"  # practice atau live

# Macro Data & Scheduled Economic Calendar
FRED_API_KEY="your_fred_api_key_here"  # St. Louis Fed API key (CPI, NFP, GDP, PCE release dates & macro yields)

# Operational Configuration
DATABASE_PATH="data/trading.db"
LOG_LEVEL="INFO"
MYFXBOOK_URL="https://www.myfxbook.com/members/example/aeterna-xauusd/123456"
